enclave {
    from "sgx_tstdc.edl" import *;
    from "sgx_socket.edl" import *;
    from "sgx_tsgxssl.edl" import *;
    from "sgx_ttls.edl" import *;
    from "sgx_pthread.edl" import *;
    trusted {
        public sgx_status_t e_main(int	eargc,
				   [in, count=eargc] int *eargpos,
				   int	eblen,
				   [in, size=eblen] char *ebuf);
    };
    untrusted {
        void ocall_time([out] uint64_t *timep);
	void ocall_open([in, string] const char *path, int flags, [out] int *ret);
	void ocall_write(int fd, [in, size=len] void *buf, size_t len, [out] size_t *wlen);
	void ocall_close(int fd, [out] int *ret);
	//void ocall_seek(int fd, size_t off, [out] int *ret);
	void ocall_read(int fd, [out, size=len] void *buf, size_t len,
	     		[out] size_t *blen);
	void ocall_readfile([in, string] const char *env,
	     		  [out, size=len] char *buf,
			  size_t len,
			  [out] size_t *blen);
        void ocall_print([in, string] const char* str);
	void ocall_puts([in, string] const char* str);
        void ocall_putn([in, string] const char* str, int len, [out] size_t *wlen);
	void ocall_getenv([in, string] const char *env,
	     		  [out, size=len] char *str,
			  int len);
  	void ocall_sock_connect(uint32_t ip, uint16_t port, [out] int *psock);
	void ocall_sock_serveropen(uint32_t ip, uint16_t port, [out] int *psock);
	void ocall_sock_accept(int sock, [out] int *rc);
	void ocall_pica_measure([in, size=32] uint8_t *nonce,
			        [out, size=rsrv_sz] uint8_t *measure,
				size_t rsrv_sz,
				[out] size_t *rep_sz,
				[in, string] const char *dpath);
	void ocall_pica_fsize([in, string] const char *path,
			      [out] size_t *sz, [out] int *fd);
	void ocall_pica_fread(int fd,
	     		      [out, size=bufsz] uint8_t *buf,
			      size_t bufsz, [out] size_t *wsz);
	void ocall_getclocktime([out] int64_t *sec, [out] int64_t *nsec);
    };
};
